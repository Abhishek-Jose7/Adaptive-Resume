# ==========================================
# Resume Maker Environment Configuration
# Strictly conforms to $0 spend & free-tier constraints
# ==========================================

# Database: Neon PostgreSQL or local PostgreSQL
# For local dev / testing: postgresql://postgres@localhost:5432/resume_maker
# For production Neon: postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres@localhost:5432/resume_maker

# Clerk Authentication (Free Tier - no credit card required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_key_for_resume_maker
CLERK_SECRET_KEY=sk_test_sample_secret_key_for_resume_maker
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/bank
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/bank

# Personal Signup Allowlist (PRD Section 6.1 R-12 / A4)
# Comma-separated list of allowed emails or domains during personal MVP phase
SIGNUP_ALLOWLIST=abhishekjose780@gmail.com,scarlettmenezes29@gmail.com

# Server Encryption Key (AES-256-GCM for BYOK provider keys)
# Must be a 32-byte hex string (64 hex characters) in production
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY=

# Optional AI Provider API Keys (User can also provide via BYOK UI)
# Google Gemini Free Tier
GEMINI_API_KEY=
# Groq Free Tier
GROQ_API_KEY=

# Local/Testing Dev Auth Bypass
# CRITICAL: MUST be false in all production and deployed environments.
# The app will hard-fail startup if set to true in production.
ENABLE_DEV_AUTH_BYPASS=false
# DEV_USER_ID=usr_dev_personal_test_id
# DEV_USER_EMAIL=dev@example.com

# OCR.space External Engine (for Scanned PDFs and Images)
OCR_SPACE_API_KEY=
